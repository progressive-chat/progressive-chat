+            .y = y,
+            .relativeSize = scene::axes::kNone,
+            .width = wide,
+            .height = attach_menu_row - 4.0f,
+            .cornerRadius = 10.0f};
+  }
+  // What a row is called.
+  [[nodiscard]] static scene::Spec name_spec(float y) {
