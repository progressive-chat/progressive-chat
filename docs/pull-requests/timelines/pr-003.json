clone_url":"https://github.com/progressive-chat/progressive-chat.git","svn_url":"https://github.com/progressive-chat/progressive-chat","homepage":null,"size":14742,"stargazers_count":0,"watchers_count":0,"language":"C++","has_issues":true,"has_projects":true,"has_downloads":false,"has_wiki":true,"has_pages":true,"has_discussions":false,"forks_count":1,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":0,"license":{"key":"agpl-3.0","name":"GNU Affero General Public License v3.0","spdx_id":"AGPL-3.0","url":"https://api.github.com/licenses/agpl-3.0","node_id":"MDc6TGljZW5zZTE="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":[],"visibility":"public","forks":1,"open_issues":0,"watchers":0,"default_branch":"main","permissions":{"admin":true,"maintain":true,"push":true,"triage":true,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/progressive-chat/progressive-chat/pulls/10","html_url":"https://github.com/progressive-chat/progressive-chat/pull/10","diff_url":"https://github.com/progressive-chat/progressive-chat/pull/10.diff","patch_url":"https://github.com/progressive-chat/progressive-chat/pull/10.patch","merged_at":null},"body":"What a fold says of the calls an answer made is a count: *Thought for 4.2 s · 3\ntool calls*. Pressed open it says what the model wrote to itself, and until now\nsaid nothing else — nothing anywhere kept **what each of them asked for or what\nit was given back**, though this program answers every call itself\n(`tools::owned::answered`, pchat.tools) and could say both.\n\nSo each one is kept whole now, with the answer that asked for it:\n\n- `called` in pchat.core: what it is called, what it asked for, what it was\n  given back. Standing last in `message`, as everything added after a struct\n  was first said does, so what says a message field after field — the sample —\n  keeps saying what it said.\n- Recorded in `src/app/screens.cc` where the loop answers a call: one `called`\n  per round, kept on the answer's own record and written into the message when\n  the answer is. Nothing is said twice where a second round asks again.\n- Drawn in `src/ui/message_list.cc` as `called_row` — a name line, what it\n  asked for, what came back, monospace for both the asking and the answer —\n  six at a time under the greentext, and only while the fold is open, since\n  what is folded says the count and nothing more.\n- Three of the sample's answers keep calls of their own: three for the first\n  (one of each tool this program has), one for the second, two for the sieve.\n  A fold has something in it to press open before any wire has answered.\n\nThe design says this of them (design-doc.md, \"Folded above it\"), and says it\nnow of what each was asked and given as well as that there were any.\n\n#3, which said their names and nothing more, was closed in favour of this one — its body said so itself.\n\n","reactions":{"url":"https://api.github.com/repos/progressive-chat/progressive-chat/issues/10/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/progressive-chat/progressive-chat/issues/10/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":35393957047,"node_id":"RTE_lADOVh5n288AAAABc_YIYM8AAAAIPaTstw","url":"https://api.github.com/repos/progressive-chat/progressive-chat/issues/events/35393957047","actor":{"login":"MaurerAnton","id":280889559,"node_id":"U_kgDOEL4I1w","avatar_url":"https://avatars.githubusercontent.com/u/280889559?v=4","gravatar_id":"","url":"https://api.github.com/users/MaurerAnton","html_url":"https://github.com/MaurerAnton","followers_url":"https://api.github.com/users/MaurerAnton/followers","following_url":"https://api.github.com/users/MaurerAnton/following{/other_user}","gists_url":"https://api.github.com/users/MaurerAnton/gi