[{"sha":"65ba6dae749028767c9ca3fe56ea8803773a01c0","node_id":"C_kwDOVh5n29oAKDY1YmE2ZGFlNzQ5MDI4NzY3YzljYTNmZTU2ZWE4ODAzNzczYTAxYzA","url":"https://api.github.com/repos/progressive-chat/progressive-chat/git/commits/65ba6dae749028767c9ca3fe56ea8803773a01c0","html_url":"https://github.com/progressive-chat/progressive-chat/commit/65ba6dae749028767c9ca3fe56ea8803773a01c0","author":{"name":"Anton Maurer","email":"developer@maureranton.com","date":"2026-11-08T13:41:03Z"},"committer":{"name":"Anton Maurer","email":"developer@maureranton.com","date":"2026-11-08T14:06:59Z"},"tree":{"sha":"f3314e3b637bd007fe38945b6703e448523b08b0","url":"https://api.github.com/repos/progressive-chat/progressive-chat/git/trees/f3314e3b637bd007fe38945b6703e448523b08b0"},"message":"an archive of everything, written as .prgrssv\n\nEverything the model holds -- accounts, conversations with what thought each\nanswer and what its calls asked and got, and the settings the page has set --\nzipped into one file under the extension .prgrssv. The zipping is the port's\nown writer, kept on the classic side behind one plain header the way its\nheaders are kept everywhere else; the module only says what the archive holds,\nand a test reads every byte of it back through the port's reader.\n\nAsked for on the settings page's About (\"An archive of everything\"), answered\nwith a machine's own save dialog: skiff's hooks deliver the chosen path to the\nprogram and skiff's storage writes the bytes there -- a page turns that file\ninto a download under its own name, a desk leaves it where it was asked to\nstand. Where a phone's SDL has no save dialog to show, the press answers\nnothing and says so through dialog_failed.","parents":[{"sha":"c8d555885bae233b08194a422d39de5879fc9d06","url":"https://api.github.com/repos/progressive-chat/progressive-chat/git/commits/c8d555885bae233b08194a422d39de5879fc9d06","html_url":"https://github.com/progressive-chat/progressive-chat/commit/c8d555885bae233b08194a422d39de5879fc9d06