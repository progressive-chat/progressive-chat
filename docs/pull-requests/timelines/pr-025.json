[{"sha":"9cfc02e71d2e87c16c4f15d1801c89662f39acc2","node_id":"C_kwDOVh5n29oAKDljZmMwMmU3MWQyZTg3YzE2YzRmMTVkMTgwMWM4OTY2MmYzOWFjYzI","url":"https://api.github.com/repos/progressive-chat/progressive-chat/git/commits/9cfc02e71d2e87c16c4f15d1801c89662f39acc2","html_url":"https://github.com/progressive-chat/progressive-chat/commit/9cfc02e71d2e87c16c4f15d1801c89662f39acc2","author":{"name":"Anton Maurer","email":"developer@maureranton.com","date":"2026-11-08T19:04:48Z"},"committer":{"name":"MaurerAnton","email":"MaurerAnton@users.noreply.github.com","date":"2026-11-08T19:27:12Z"},"tree":{"sha":"864dcd3d7967d77cac1361230f7e085137f12999","url":"https://api.github.com/repos/progressive-chat/progressive-chat/git/trees/864dcd3d7967d77cac1361230f7e085137f12999"},"message":"the archive label placed where a group heading is placed\n\nkCentreLeft was adding the centre of the whole column to the row's own y: the\nbox came out past the column and was culled with everything drawn outside it.\nAnchored to the top left, the same x and a y for the middle of its own row --\nthe way every heading of this page stands, and the only bare labels of it that\nhave ever been drawn.","parents":[{"sha":"ee131ca136493bcb7920042453d1d97f7a3fc08e","url":"https://api.github.com/repos/progressive-chat/progressive-chat/git/commits/ee131ca136493bcb7920042453d1d97f7a3fc08e","html_url":"https://github.com/progressive-chat/progressive-chat/commit/ee131ca136493bcb7920042453d1d97f7a3fc08e"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"f4dfaab6d66bc6a77e7763dfc5ed4d8d253f3a9c","node_id":"C_kwDOVh5n29oAKGY0ZGZhYWI2ZDY2YmM2YTc3ZTc3NjNkZmM1ZWQ0ZDhkMjUzZjNhOWM","url":"https://api.github.com/repos/progressive-chat/progressive-chat/git/commits/f4dfaab6d66bc6a77e7763dfc5ed4d8d253f3a9c","html_url":"https://github.com/progressive-chat/progressive-chat/commit/f4dfaab6d66bc6a77e7763dfc5ed4d8d253f3a9c","author":{"name":"Anton Maurer","email":"developer@maureranton.com","date":"2026-11-08T20:13:23Z"},"committer":{"name":"Anton Maurer","email":"developer@maureranton.com","date":"2026-11-08T20:13:23Z"},"tree":{"sha":"16cdb300d53067ce377c0c9a786699564cac4278","url":"https://api.github.com/repos/progressive-chat/progressive-chat/git/trees/16cdb300d53067ce377c0c9a786699564cac4278"},"message":"the design plate and the items of a group placed as their headings are\n\nThe same sum that hid the archive's words hid these too: kCentreLeft with a\nrow's own y as though it stood on its own, when anchoredBox adds the parent's\ncentre to it -- the design's plate has stood wordless since it was written,\nand no bare item label of this page has ever been drawn. Top left now, a y in\nthe middle of the row the label is for, and an origin that does not keep half\na centre over from the making of the window.","parents":[{"sha":"9cfc02e71d2e87c16c4f15d1801c89662f39acc2","url":"https://api.github.com/repos/progressive-chat/progressive-chat/git/commits/9cfc02e71d2e87c16c4f15d1801c89662f39acc2","html_url":"https://github.com/progressive-chat/progressive-chat/commit/9cfc02e71d2e87c16c4f15d1801c89662f39acc2"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"id":35512141023,"node_id":"ME_lADOVh5n288AAAABdgchuc8AAAAIRLBE3w","url":"https://api.github.com/repos/progressive-chat/progressive-chat/issues/events/35512141023","actor":{"login":"MaurerAnton","id":280889559,"node_id":"U_kgDOEL4I1w","avatar_url":"https://avatars.githubusercontent.com/u/280889559?v=4","gravatar_id":"","url":"https://api.github.com/users/MaurerAnton","html_url":"https://github.com/MaurerAnton","followers_url":"https://api.github.com/users/MaurerAnton/followers","following_url":"https://api.github.com/users/MaurerAnton/following{/other_user}","gists_url":"https://api.github.com/users/MaurerAnton/gists{/gist_id}","starred_url":"https://api.github.com/users/MaurerAnton/starred