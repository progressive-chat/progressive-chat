[{"sha":"dbf7ee5249f03c13b47aabe31e65af598d21f97f","node_id":"C_kwDOVh5n29oAKGRiZjdlZTUyNDlmMDNjMTNiNDdhYWJlMzFlNjVhZjU5OGQyMWY5N2Y","url":"https://api.github.com/repos/progressive-chat/progressive-chat/git/commits/dbf7ee5249f03c13b47aabe31e65af598d21f97f","html_url":"https://github.com/progressive-chat/progressive-chat/commit/dbf7ee5249f03c13b47aabe31e65af598d21f97f","author":{"name":"MaurerAnton","email":"MaurerAnton@users.noreply.github.com","date":"2026-11-09T07:05:22Z"},"committer":{"name":"MaurerAnton","email":"MaurerAnton@users.noreply.github.com","date":"2026-11-09T07:07:22Z"},"tree":{"sha":"2a139ca71defeca7345c0b97cf80e6accfe7e3a9","url":"https://api.github.com/repos/progressive-chat/progressive-chat/git/trees/2a139ca71defeca7345c0b97cf80e6accfe7e3a9"},"message":"what of a conversation fits the window its answerer has\n\nThe conversation was asked about whole, whatever room the answerer's window\nhad: Agora trims to the newest run that fits (limitContext, over what the\nmodel is told and the tools it may ask for, taken off the window first), and\nnothing here did. Now the oldest message that still fits is said as an id, and\nthe asking starts there -- the messages themselves stay whole, are drawn as\nthey were, and the tools are still read every one of them.\n\nThe fitting stands in a classic translation unit behind one plain header, the\nway the counters and the wires do, so that agora's headers stay out of module\nunits; the module above it says only what a screen may name. src/ is given to\nthe provider library plainly, which a file set does not do on its own, and the\nport's own ssh test joins the list of binaries `pchat-tests` asks for, so that\none build of it gives ctest everything a test here says by.","parents":[{"sha":"b1477976e3b9bf42636bda9bc89c4b5a57b738e3","url":"https://api.github.com/repos/progressive-chat/progressive-chat/git/commits/b1477976e3b9bf42636bda9bc89c4b5a57b738e3","html_url":"https://github.com/progressive-chat/progressive-chat/commit/b1477976e3b9bf42636bda9bc89c4b5a57b738e3"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"1d9aa497879ebb5022f128bf7a7716f75f4b11c5","node_id":"C_kwDOVh5n29oAKDFkOWFhNDk3ODc5ZWJiNTAyMmYxMjhiZjdhNzcxNmY3NWY0YjExYzU","url":"https://api.github.com/repos/progressive-chat/progressive-chat/git/commits/1d9aa497879ebb5022f128bf7a7716f75f4b11c5","html_url":"https://github.com/progressive-chat/progressive-chat/commit/1d9aa497879ebb5022f128bf7a7716f75f4b11c5","author":{"name":"MaurerAnton","email":"MaurerAnton@users.noreply.github.com","date":"2026-11-09T07:06:23Z"},"committer":{"name":"MaurerAnton","email":"MaurerAnton@users.noreply.github.com","date":"2026-11-09T07:07:22Z"},"tree":{"sha":"c100a6b82cab4a378cd88fb4893deb5313731789","url":"https://api.github.com/repos/progressive-chat/progressive-chat/git/trees/c100a6b82cab4a378cd88fb4893deb5313731789"},"message":"the settings a reader set said again where the question is asked\n\nEvery row of the generation settings moved a number the program kept, wrote\nnowhere, and never gave to a wire: the asking built a `wanted` of the tools\nalone, so temperature, top-p, the ceiling on an answer, the penalties and the\nthinking itself were all read out of the settings and dropped on the way to\nthe body. Both halves are said in one place already (src/tools.cc,\n`wanted_of`), and this is the asking calling it.\n\nThe probe that reads the request off the page says all of it held: what\ncarried it is checked where it is written, which is the request itself and not\nthe page that cannot say what it wrote.","parents":[{"sha":"dbf7ee5249f03c13b47aabe31e65af598d21f97f","url":"https://api.github.com/repos/progressive-chat/progressive-chat/git/commits/dbf7ee5249f03c13b47aabe31e65af598d21f97f","html_url":"https://github.com/progressive-chat/progressive-chat/commit/dbf7ee5249f03c13b47aabe31e65af598d21f97f"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"8a19a021b3f0913f295e8adb7249b76a8e864a84","node_id":"C_kwDOVh5n29oAKDhhMTlhMDIxYjNmMDkxM2YyOTVlOGFkYjcyNDliNzZhOGU4NjRhODQ","url":"https://api.github.com/repos/progressive-chat/progressive-chat/git/commits/8a19a021b3f0913f295e8adb7249b76a8e864a84","html_url":"https://github.com/progressive-chat/progressive-chat/commit/8a19a021b3f0913f295e8adb7249b76a8e864a84","author":{"name":"MaurerAnton","email":"MaurerAnton@users.noreply.github.com","date":"2026-11-09T07:06:23Z"},"committer":{"name":"MaurerAnton","email":"MaurerAnton@users.noreply.github.com","date":"2026-11-09T07:07:22Z"},"tree":{"sha":"c81091a46479d5c9310c9205ed75230863c3df33","url":"https://api.github.com/repos/progressive-chat/progressive-chat/git/trees/c81091a46479d5c9310c9205ed75230863c3df33"},"message":"thinking asked for in the budget this family takes it in\n\nThe chat wire, the relay's and Google's each said their own word for a\nthinking, and the anthropic one said nothing at all -- the reader could ask\nfor it as hard as they liked and the body went out without it. Now it goes as\nthis family takes it: a type beside a budget of tokens to think with, asked of\nthe capability Agora keeps for a model, where the model takes one at all, and\nnothing said where it does not (a generation from before extended thinking is\ngiven no parameter of it).\n\nTwo things follow from it that the same capability decides: the numbers that\nchoose the words are not read beside a thinking at all, except a top_p in\n0.95..1 which is the one place this family still allows; and the room asked\nfor is the budget plus the headroom to answer in under the same ceiling,\nbecause Anthropic reads both out of one max_tokens.","parents":[{"sha":"1d9aa497879ebb5022f128bf7a7716f75f4b11c5","url":"https://api.github.com/repos/progressive-chat/progressive-chat/git/commits/1d9aa497879ebb5022f128bf7a7716f75f4b11c5","html_url":"https://github.com/progressive-chat/progressive-chat/commit/1d9aa497879ebb5022f128bf7a7716f75f4b11c5"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"ea2f935322b06a4607373a62906f1d575e667327","node_id":"C_kwDOVh5n29oAKGVhMmY5MzUzMjJiMDZhNDYwNzM3M2E2MjkwNmYxZDU3NWU2NjczMjc","url":"https://api.github.com/repos/progressive-chat/progressive-chat/git/commits/ea2f935322b06a4607373a62906f1d575e667327","html_url":"https://github.com/progressive-chat/progressive-chat/commit/ea2f935322b06a4607373a62906f1d575e667327","author":{"name":"Anton Maurer","email":"developer@maureranton.com","date":"2026-11-08T21:48:20Z"},"committer":{"name":"MaurerAnton","email":"MaurerAnton@users.noreply.github.com","date":"2026-11-09T07:27:23Z"},"tree":{"sha":"dbdde49b6c7d09df9012d188b1047627d49792dc","url":"https://api.github.com/repos/progressive-chat/progressive-chat/git/trees/dbdde49b6c7d09df9012d188b1047627d49792dc"},"message":"readme: the day's paragraph; how-mux-was-found said in English; the http test's root\n\nThe readme opens without the creation line and carries today's paragraph at the\nhead of the day list. The transcript where mux was found now reads in English\nthroughout. The http test reaches the folder's header over the tree's own src,\nwhich the scan-deps pass was not given.","parents":[{"sha":"8a19a021b3f0913f295e8adb7249b76a8e864a84","url":"https://api.github.com/repos/progressive-chat/progressive-chat/git/commits/8a19a021b3f0913f295e8adb7249b76a8e864a84","html_url":"https://github.com/progressive-chat/progressive-chat/commit/8a19a021b3f0913f295e8adb7249b76a8e864a84"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"69a911390530abb3ef69849765acd1d10e625760","node_id":"C_kwDOVh5n29oAKDY5YTkxMTM5MDUzMGFiYjNlZjY5ODQ5NzY1YWNkMWQxMGU2MjU3NjA","url":"https://api.github.com/repos/progressive-chat/progressive-chat/git/commits/69a911390530abb3ef6