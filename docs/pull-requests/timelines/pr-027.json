-chat/progressive-chat/git/commits/69a911390530abb3ef69849765acd1d10e625760","html_url":"https://github.com/progressive-chat/progressive-chat/commit/69a911390530abb3ef69849765acd1d10e625760"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"48afde1acb842a059525810cf4e9d930382e9c73","node_id":"C_kwDOVh5n29oAKDQ4YWZkZTFhY2I4NDJhMDU5NTI1ODEwY2Y0ZTlkOTMwMzgyZTljNzM","url":"https://api.github.com/repos/progressive-chat/progressive-chat/git/commits/48afde1acb842a059525810cf4e9d930382e9c73","html_url":"https://github.com/progressive-chat/progressive-chat/commit/48afde1acb842a059525810cf4e9d930382e9c73","author":{"name":"Anton Maurer","email":"developer@maureranton.com","date":"2026-11-09T00:16:57Z"},"committer":{"name":"MaurerAnton","email":"MaurerAnton@users.noreply.github.com","date":"2026-11-09T07:27:24Z"},"tree":{"sha":"0fe1552558f6f289a919b861138c6d3865abd860","url":"https://api.github.com/repos/progressive-chat/progressive-chat/git/trees/0fe1552558f6f289a919b861138c6d3865abd860"},"message":"CODE_STYLE: the commit naming rule removed","parents":[{"sha":"6e9b32af0928a9ed20890fd0dca1cc4917f5e52e","url":"https://api.github.com/repos/progressive-chat/progressive-chat/git/commits/6e9b32af0928a9ed20890fd0dca1cc4917f5e52e","html_url":"https://github.com/progressive-chat/progressive-chat/commit/6e9b32af0928a9ed20890fd0dca1cc4917f5e52e"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"d1fe6bbc56cda9b72e4491b86c38aee80297903d","node_id":"C_kwDOVh5n29oAKGQxZmU2YmJjNTZjZGE5YjcyZTQ0OTFiODZjMzhhZWU4MDI5NzkwM2Q","url":"https://api.github.com/repos/progressive-chat/progressive-chat/git/commits/d1fe6bbc56cda9b72e4491b86c38aee80297903d","html_url":"https://github.com/progressive-chat/progressive-chat/commit/d1fe6bbc56cda9b72e4491b86c38aee80297903d","author":{"name":"Anton Maurer","email":"developer@maureranton.com","date":"2026-11-09T03:54:53Z"},"committer":{"name":"MaurerAnton","email":"MaurerAnton@users.noreply.github.com","date":"2026-11-09T07:27:24Z"},"tree":{"sha":"824d3b4e4b30616cddd1a61f87d8ef41d28cb876","url":"https://api.github.com/repos/progressive-chat/progressive-chat/git/trees/824d3b4e4b30616cddd1a61f87d8ef41d28cb876"},"message":"a lost connection asked again, and a credential kept out of the clear\n\nThe port's http policy off the shelf and into the running program: a run\nwhose asking would carry an API credential over plain http:// to a host that\nis not this machine's own never sets out -- the port's own guard refuses it at\nthe making of the asking, and the screens read why. A carrying that loses the\nconnection asks again with the very same fields, three askings in all and only\nbefore a byte of the answer has come, which is what the port's\nretry_on_connection_failure says and what a page's fetch never did by itself.\nAn answer that says no (4xx/5xx) is still never asked again.","parents":[{"sha":"48afde1acb842a059525810cf4e9d930382e9c73","url":"https://api.github.com/repos/progressive-chat/progressive-chat/git/commits/48afde1acb842a059525810cf4e9d930382e9c73","html_url":"https://github.com/progressive-chat/progressive-chat/commit/48afde1acb842a059525810cf4e9d930382e9c73"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"5f7a238f5f3a2dc43ae89df40e5a6eb9556b4732","node_id":"C_kwDOVh5n29oAKDVmN2EyMzhmNWYzYTJkYzQzYWU4OWRmNDBlNWE2ZWI5NTU2YjQ3MzI","url":"https://api.github.com/repos/progressive-chat/progressive-chat/git/commits/5f7a238f5f3a2dc43ae89df40e5a6eb9556b4732","html_url":"https://github.com/progressive-chat/progressive-chat/commit/5f7a238f5f3a2dc43ae89df40e5a6eb9556b4732","author":{"name":"Anton Maurer","email":"developer@maureranton.com","date":"2026-11-09T04:32:26Z"},"committer":{"name":"MaurerAnton","email":"MaurerAnton@users.noreply.github.com","date":"2026-11-09T07:27:24Z"},"tree":{"sha":"4b01aeac97416b6fc530e72f8b7a1968c5b8244a","url":"https://api.github.com/repos/progressive-chat/progressive-chat/git/trees/4b01aeac97416b6fc530e72f8b7a1968c5b8244a"},"message":"the http header asked for by its own place, not by src's\n\nrun.cc stands in src/provider/, so provider/http/wire.h resolved to a\nprovider/provider that was never there -- the same include written the way\nprovider.cc writes one from src/ instead: relative to the file that names it.","parents":[{"sha":"d1fe6bbc56cda9b72e4491b86c38aee80297903d","url":"https://api.github.com/repos/progressive-chat/progressive-chat/git/commits/d1fe6bbc56cda9b72e4491b86c38aee80297903d","html_url":"https://github.com/progressive-chat/progressive-chat/commit/d1fe6bbc56cda9b72e4491b86c38aee80297903d"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"id":35545957644,"node_id":"ME_lADOVh5n288AAAABdmm7H88AAAAIRrRFDA","url":"https://api.github.com/repos/progressive-chat/progressive-chat/issues/events/35545957644","actor":{"login":"MaurerAnton","id":280889559,"node_id":"U_kgDOEL4I1w","avatar_url":"https://avatars.githubusercontent.com/u/280889559?v=4","gravatar_id":"","url":"https://api.github.com/users/MaurerAnton","html_url":"https://github.com/MaurerAnton","followers_url":"https://api.github.com/users/MaurerAnton/followers","following_url":"https://api.github.com/users/MaurerAnton/following{/other_user}","gists_url":"https://api.github.com/users/MaurerAnton/gists{/gist_id}","starred_url":"https://api.github.com/users/MaurerAnton/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MaurerAnton/subscriptions","organizations_url":"https://api.github.com/users/MaurerAnton/orgs","repos_url":"https://api.github.com/users/MaurerAnton/repos","events_url":"https://api.github.com/users/MaurerAnton/events{/privacy}","received_events_url":"https://api.github.com/users/MaurerAnton/received_events","type":"