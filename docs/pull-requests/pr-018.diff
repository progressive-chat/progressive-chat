diff --git a/src/platform/jni_android.cc b/src/platform/jni_android.cc
new file mode 100644
index 00000000..f0169888
--- /dev/null
+++ b/src/platform/jni_android.cc
@@ -0,0 +1,56 @@
+// SPDX-License-Identifier: AGPL-3.0-only
+// pchat.platform.jni -- What an Android backend calls Java through: the JNI
+// environment of this thread, and text given to Java as UTF-8. From whichever
+// thread asks: SDL attaches it to the virtual machine.
+module;
+#include <SDL3/SDL.h>
+#include <jni.h>
+// SPDX-License-Identifier: AGPL-3.0-only
+export module pchat.platform.jni;
+
+import std;
+
+export namespace pchat::platform {
+
+// The JNI environment of this thread, with a frame the local references made
+// inside it are let go with, and whatever exception a call threw cleared as it
+// goes: an exception left standing throws again at the next call, which is not
+// where it came from.
+class jni_frame {
+ public:
+  jni_frame() : env_(static_cast<JNIEnv *>(SDL_GetAndroidJNIEnv())) {
+    ready_ = env_ && env_->PushLocalFrame(64) == JNI_OK;
+  }
+  jni_frame(const jni_frame &) = delete;
+  jni_frame &operator=(const jni_frame &) = delete;
+  ~jni_frame() {
+    if (env_ && env_->ExceptionCheck()) env_->ExceptionClear();
+    if (ready_) env_->PopLocalFrame(nullptr);
+  }
+  [[nodiscard]] JNIEnv *env() const { return ready_ ? env_ : nullptr; }
+
+ private:
+  JNIEnv *env_ = nullptr;
+  bool ready_ = false;
+};
+
+// UTF-8 as a java.lang.String: through new String(bytes, "UTF-8"), and not
+// through NewStringUTF, whose modified UTF-8 is not UTF-8 for what is past the
+// basic plane -- a title or a body with an emoji in it would come out wrong.
+[[nodiscard]] inline jstring string_of(JNIEnv *env, std::string_view text) {
+  std::vector<jbyte> bytes;
+  bytes.reserve(text.size());
+  for (const char one : text) bytes.push_back(static_cast<jbyte>(one));
+  jbyteArray array = env->NewByteArray(static_cast<jsize>(bytes.size()));
+  if (!array) return nullptr;
+  env->SetByteArrayRegion(array, 0, static_cast<jsize>(bytes.size()),
+                          bytes.data());
+  jclass string_class = env->FindClass("java/lang/String");
+  return static_cast<jstring>(
+      env->NewObject(string_class,
+                     env->GetMethodID(string_class, "<init>",
+                                      "([BLjava/lang/String;)V"),
+                     array, env->NewStringUTF("UTF-8")));
+}
+
+}  // namespace pchat::platform
diff --git a/src/platform/notified.cc b/src/platform/notified.cc
new file mode 100644
index 00000000..e9cbd2dc
--- /dev/null
+++ b/src/platform/notified.cc
@@ -0,0 +1,21 @@
+// SPDX-License-Identifier: AGPL-3.0-only
+// pchat.platform.notified -- One notification, put where the machine this
+// program runs on puts notifications, for a screen to ask for: the title and
+// the body go in, and whether anything was shown comes out.
+//
+// Behind it is what the platform gives (src/platform/notified_backend*.cc):
+// a notification of Android's own on a phone, and nothing at all everywhere
+// else, which this says in what it answers with. Nothing above this knows
+// which of them it got.
+export module pchat.platform.notified;
+
+import std;
+import pchat.platform.notified.backend;
+
+export namespace pchat::platform::notified {
+
+bool say(std::string_view title, std::string_view text) {
+  return backend::say(title, text);
+}
+
+}  // namespace pchat::platform::notified
diff --git a/src/platform/notified_backend.cc b/src/platform/notified_backend.cc
new file mode 100644
index 00000000..d3574b02
--- /dev/null
+++ b/src/platform/notified_backend.cc
@@ -0,0 +1,13 @@
+// SPDX-License-Identifier: AGPL-3.0-only
+// pchat.platform.notified.backend -- Where nothing puts notifications: this
+// program asks the machine for none, and is told that none was shown. What a
+// window and a page say until they are given one of their own.
+export module pchat.platform.notified.backend;
+
+import std;
+
+export namespace pchat::platform::notified::backend {
+
+bool say(std::string_view, std::string_view) { return false; }
+
+}  // namespace pchat::platform::notified::backend
diff --git a/src/platform/notified_backend_android.cc b/src/platform/notified_backend_android.cc
new file mode 100644
index 00000000..cdfe473d
--- /dev/null
+++ b/src/platform/notified_backend_android.cc
@@ -0,0 +1,196 @@
+// SPDX-License-Identifier: AGPL-3.0-only
+// pchat.platform.notified.backend -- Android's notifications: one posted
+// through NotificationManager, in a channel of this program's own (Android 8
+// and later need one, and list an app that has none among those that send
+// nothing), opening the program when it is pressed. Asked through JNI, from
+// whichever thread asks: SDL attaches it to the virtual machine.
+//
+// Android 13 and later post a notification only for an app the user let post
+// them: the first press asks for that, and shows nothing, because the answer
+// is not given while this call is in it. It is the system's to keep, so it is
+// asked once and never again.
+module;
+#include <SDL3/SDL.h>
+#include <jni.h>
+// SPDX-License-Identifier: AGPL-3.0-only
+export module pchat.platform.notified.backend;
+
+import std;
+import pchat.platform.jni;
+
+namespace {
+
+// The channel a test notification is posted in, made each time: making one
+// again changes nothing the user has set in it.
+constexpr const char *channel_id = "tests";
+constexpr const char *channel_name = "Tests";
+constexpr jint importance_high = 4;  // NotificationManager.IMPORTANCE_HIGH
+
+// Whether this program may post: PackageManager.PERMISSION_GRANTED is 0.
+bool let_post(JNIEnv *env, jobject activity) {
+  jclass context = env->FindClass("android/content/Context");
+  if (!context) return false;
+  return env->CallIntMethod(activity,
+                            env->GetMethodID(context, "checkSelfPermission",
+                                             "(Ljava/lang/String;)I"),
+                            env->NewStringUTF(
+                                "android.permission.POST_NOTIFICATIONS")) == 0;
+}
+
+// Asked for it once, where it was not given yet: the system's own asking, for
+// whose answer nothing here waits.
+void ask_to_post(JNIEnv *env, jobject activity) {
+  jobjectArray asked = env->NewObjectArray(
+      1, env->FindClass("java/lang/String"), nullptr);
+  if (!asked) return;
+  env->SetObjectArrayElement(
+      asked, 0, env->NewStringUTF("android.permission.POST_NOTIFICATIONS"));
+  jclass activity_class = env->FindClass("android/app/Activity");
+  if (!activity_class) return;
+  env->CallVoidMethod(activity,
+                      env->GetMethodID(activity_class, "requestPermissions",
+                                       "([Ljava/lang/String;I)V"),
+                      asked, 0);
+}
+
+void make_channel(JNIEnv *env, jobject manager) {
+  jclass channel_class = env->FindClass("android/app/NotificationChannel");
+  if (!channel_class) return;
+  jobject channel = env->NewObject(
+      channel_class,
+      env->GetMethodID(channel_class, "<init>",
+                       "(Ljava/lang/String;Ljava/lang/CharSequence;I)V"),
+      env->NewStringUTF(channel_id), pchat::platform::string_of(env, channel_name),
+      importance_high);
+  if (!channel) return;
+  env->CallVoidMethod(
+      manager,
+      env->GetMethodID(env->GetObjectClass(manager),
+                       "createNotificationChannel",
+                       "(Landroid/app/NotificationChannel;)V"),
+      channel);
+}
+
+// What a press on it does: the program brought up, as its own icon would.
+jobject opening(JNIEnv *env, jobject activity, int sdk) {
+  jclass context = env->FindClass("android/content/Context");
+  if (!context) return nullptr;
+  jobject packages = env->CallObjectMethod(
+      activity, env->GetMethodID(context, "getPackageManager",
+                                 "()Landroid/content/pm/PackageManager;"));
+  jobject name = env->CallObjectMethod(
+      activity,
+      env->GetMethodID(context, "getPackageName", "()Ljava/lang/String;"));
+  if (!packages || !name) return nullptr;
+  jobject intent = env->CallObjectMethod(
+      packages,
+      env->GetMethodID(env->GetObjectClass(packages),
+                       "getLaunchIntentForPackage",
+                       "(Ljava/lang/String;)Landroid/content/Intent;"),
+      name);
+  if (!intent) return nullptr;
+  // FLAG_IMMUTABLE, which Android 12 and later ask of every PendingIntent;
+  // FLAG_UPDATE_CURRENT, the intent the newest one it was given.
+  constexpr jint immutable = 0x04000000, update_current = 0x08000000;
+  jclass pending = env->FindClass("android/app/PendingIntent");
+  if (!pending) return nullptr;
+  return env->CallStaticObjectMethod(
+      pending,
+      env->GetStaticMethodID(
+          pending, "getActivity",
+          "(Landroid/content/Context;ILandroid/content/Intent;I)"
+          "Landroid/app/PendingIntent;"),
+      activity, 1, intent, (sdk >= 23 ? immutable : 0) | update_current);
+}
+
+// The small icon at its left: the platform's own chat icon, asked for by name
+// -- this program ships no drawable of its own.
+jint icon(JNIEnv *env, jobject activity) {
+  jclass context = env->FindClass("android/content/Context");
+  if (!context) return 0;
+  jobject resources = env->CallObjectMethod(
+      activity, env->GetMethodID(context, "getResources",
+                                 "()Landroid/content/res/Resources;"));
+  if (!resources) return 0;
+  return env->CallIntMethod(
+      resources,
+      env->GetMethodID(env->GetObjectClass(resources), "getIdentifier",
+                       "(Ljava/lang/String;Ljava/lang/String;Ljava/lang/"
+                       "String;)I"),
+      env->NewStringUTF("stat_notify_chat"), env->NewStringUTF("drawable"),
+      env->NewStringUTF("android"));
+}
+
+}  // namespace
+
+export namespace pchat::platform::notified::backend {
+
+bool say(std::string_view title, std::string_view text) {
+  const pchat::platform::jni_frame frame;
+  JNIEnv *env = frame.env();
+  if (!env) return false;
+  const auto activity = static_cast<jobject>(SDL_GetAndroidActivity());
+  if (!activity) return false;
+  const int sdk = SDL_GetAndroidSDKVersion();
+  if (sdk >= 33 && !let_post(env, activity)) {
+    ask_to_post(env, activity);
+    return false;
+  }
+  jclass context = env->FindClass("android/content/Context");
+  if (!context) return false;
