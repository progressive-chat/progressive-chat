 }
 
+SAID(provider_run, a_credential_never_sets_out_in_the_clear) {
+  const std::vector<provider::turn> turns{
+      provider::turn{.who = provider::role::user, .text = "Hello"}};
+  // A key, a plain-http place and a host that is not this machine's own: the
+  // port's guard refuses it, so the run is over before any transport could
+  // carry it, and why it never went is said for the screens.
+  provider::run refused{
+      provider::endpoint{.base = "http://api.example.com/v1",
+                         .key = "sk-secret",
+                         .model = "o4-mini",
+                         .told = "You are brief."},
+      turns};
+  EXPECT_TRUE(refused.done());
+  EXPECT_TRUE(refused.ended() == provider::over::failed);
+  EXPECT_TRUE(refused.trouble().has_value());
+  EXPECT_TRUE(refused.trouble()->find("cleartext") != std::string::npos);
+  // Encrypted, and a host of this machine's own: both asked of as usual.
+  provider::run encrypted{
+      provider::endpoint{.base = "https://api.openai.com/v1",
+                         .key = "sk-secret",
+                         .model = "o4-mini",
+                         .told = "You are brief."},
+      turns};
+  EXPECT_TRUE(encrypted.where() == provider::standing::ready);
+  EXPECT_TRUE(encrypted.ended() == provider::over::none);
+  provider::run at_home{
+      provider::endpoint{.base = "http://127.0.0.1:11434/v1",
+                         .key = "sk-secret",
+                         .model = "local-model",
+                         .told = "You are brief."},
+      turns};
+  EXPECT_TRUE(at_home.where() == provider::standing::ready);
+}
+
 int main() { return pchat::tests::run(); }
diff --git a/test/provider_test.cc b/test/provider_test.cc
index ec1103a2..5002440c 100644
--- a/test/provider_test.cc
+++ b/test/provider_test.cc
@@ -282,4 +282,118 @@ SAID(provider, thinking_turned_off_is_asked_for_nowhere) {
   EXPECT_TRUE(provider::body_of(openai, no_turns, none).find("reasoning") == std::string::npos);
 }
 
+namespace {
+
+// What stands under one name in a body, or nothing where the body says
+// nothing of it -- so that a body missing a field is a check that did not
+// hold and not a read past the end of one.
+[[nodiscard]] const json::value *in(const json::value &body, std::string_view name) {
+  return json::said(&body, name);
+}
+
+// The number under one name, or -1 where there is none.
+[[nodiscard]] double number_in(const json::value &body, std::string_view name) {
+  const json::value *one = in(body, name);
+  if (one == nullptr)
+    return -1.0;
+  return json::number_of(*one).value_or(-1.0);
+}
+
+// The word under one name, or nothing where there is none.
+[[nodiscard]] std::string text_in(const json::value &body, std::string_view name) {
+  const json::value *one = in(body, name);
+  if (one == nullptr)
+    return std::string{};
+  return std::string(json::text_of(*one).value_or(""));
+}
+
+}  // namespace
+
+// What a thinking costs the body it is asked for in: a budget in the words
+// this family takes it in, room for an answer beside that budget -- and the
+// two numbers that choose the words taken off it, because this family does
+// not read them beside a thinking at all.
+SAID(provider, thinking_on_anthropic_is_a_budget_and_room_to_answer) {
+  const provider::endpoint at{.base = "https://api.anthropic.com/v1",
+                              .model = "haiku-4"};
+  const std::vector<provider::turn> turns{
+      provider::turn{.who = provider::role::user, .text = "Say go"}};
+  const asking how{.thinking = true, .temperature = 0.7, .top_p = 1.0,
+                   .max_tokens = 2048};
+  const auto body = json::read(provider::body_of(at, turns, provider::wants_of(how)));
+  EXPECT_TRUE(body.has_value());
+  if (!body.has_value())
+    return;
+  const json::value *thinking = in(*body, "thinking");
+  EXPECT_TRUE(thinking != nullptr);
+  if (thinking == nullptr)
+    return;
+  EXPECT_EQ(text_in(*thinking, "type"), std::string("enabled"));
+  const double budget = number_in(*thinking, "budget_tokens");
+  EXPECT_GE(budget, 1024.0);
+  // Anthropic reads the budget and the answer out of the same max_tokens, so
+  // the room asked for is the budget plus what is left to answer in with it.
+  EXPECT_LT(budget, number_in(*body, "max_tokens"));
+  EXPECT_TRUE(in(*body, "temperature") == nullptr);
+  EXPECT_EQ(number_in(*body, "top_p"), 1.0);
+}
+
+// And the same body where the reader asked for no thinking: nothing said of
+// it, and the two numbers back where they were.
+SAID(provider, thinking_off_anthropic_leaves_the_numbers_where_they_were) {
+  const provider::endpoint at{.base = "https://api.anthropic.com/v1",
+                              .model = "haiku-4"};
+  const std::vector<provider::turn> turns{
+      provider::turn{.who = provider::role::user, .text = "Say go"}};
+  const asking how{.thinking = false, .temperature = 0.7, .top_p = 0.8,
+                   .max_tokens = 2048};
+  const auto body = json::read(provider::body_of(at, turns, provider::wants_of(how)));
+  EXPECT_TRUE(body.has_value());
+  if (!body.has_value())
+    return;
+  EXPECT_TRUE(in(*body, "thinking") == nullptr);
+  EXPECT_EQ(number_in(*body, "temperature"), 0.7);
+  EXPECT_EQ(number_in(*body, "top_p"), 0.8);
+  EXPECT_EQ(number_in(*body, "max_tokens"), 2048.0);
+}
+
+// A top_p beside a thinking, kept only where this family still allows one:
+// 0.95 and above go out with it, and anything under that is left out rather
+// than sent to be refused.
+SAID(provider, a_top_p_beside_a_thinking_is_kept_only_in_095_and_up) {
+  const provider::endpoint at{.base = "https://api.anthropic.com/v1",
+                              .model = "haiku-4"};
+  const std::vector<provider::turn> turns{
+      provider::turn{.who = provider::role::user, .text = "Say go"}};
+  const asking borderline{.thinking = true, .top_p = 0.95};
+  const auto kept =
+      json::read(provider::body_of(at, turns, provider::wants_of(borderline)));
+  EXPECT_TRUE(kept.has_value());
+  if (kept.has_value())
+    EXPECT_EQ(number_in(*kept, "top_p"), 0.95);
+  const asking under{.thinking = true, .top_p = 0.7};
+  const auto gone =
+      json::read(provider::body_of(at, turns, provider::wants_of(under)));
+  EXPECT_TRUE(gone.has_value());
+  if (gone.has_value())
+    EXPECT_TRUE(in(*gone, "top_p") == nullptr);
+}
+
+// And a model that never thought -- a generation from before extended
+// thinking, which the capability says so about -- is given no thinking
+// parameter at all, however much the reader asked for one.
+SAID(provider, a_model_that_never_thought_is_asked_for_no_thinking) {
+  const provider::endpoint at{.base = "https://api.anthropic.com/v1",
+                              .model = "claude-3-haiku"};
+  const std::vector<provider::turn> turns{
+      provider::turn{.who = provider::role::user, .text = "Say go"}};
+  const asking how{.thinking = true, .temperature = 0.7};
+  const auto body = json::read(provider::body_of(at, turns, provider::wants_of(how)));
+  EXPECT_TRUE(body.has_value());
+  if (!body.has_value())
+    return;
+  EXPECT_TRUE(in(*body, "thinking") == nullptr);
+  EXPECT_EQ(number_in(*body, "temperature"), 0.7);
+}
+
 int main() { return pchat::tests::run(); }
diff --git a/tools/probe_asked.mjs b/tools/probe_asked.mjs
new file mode 100644
index 00000000..91a5d8c5
--- /dev/null
+++ b/tools/probe_asked.mjs
@@ -0,0 +1,116 @@
+// pchat.probe.asked -- What a question carries to the wire: the reader's own
+// settings whole in the body of the request the page makes -- the five
+// numbers, the thinking where the model takes one, and the tools left on --
+// read off the request itself, which is the one place all of them are said
+// together. The page cannot say what it wrote; the request can.
+//
+// The answer is made here, in the frames the wire this sample asks through
+// writes them (an anthropic one -- the opened conversation answers through
+// haiku), so that nothing waits on a server to see what went out. What is
+// asked for is checked against what the settings rows say, and the probe ends
+// with a code that says whether all of them held.
+import { chromium } from 'playwright';
+
+const url = `https://progressive-chat.github.io/progressive-chat/?asked=${Date.now()}`;
+
+// One whole answer as anthropic writes it: a message that begins, a text
+// block, and the message said over with what it cost.
+const answer = [
+  'data: {"type":"message_start","message":{"id":"msg_1","type":"message","role":"assistant","model":"haiku-4","usage":{"input_tokens":7}}}',
+  '',
+  'event: content_block_start',
+  'data: {"type":"content_block_start","index":0,"content_block":{"type":"text","text":""}}',
+  '',
+  'data: {"type":"content_block_delta","index":0,"delta":{"type":"text_delta","text":"answered-by-wire"}}',
+  '',
+  'data: {"type":"content_block_stop","index":0}',
+  '',
+  'data: {"type":"message_delta","delta":{"stop_reason":"end_turn"},"usage":{"output_tokens":5}}',
+  '',
+  'data: {"type":"message_stop"}',
+  '',
+].join('\n');
+
+const checks = [];
+const that = (holds, said) => checks.push(`${holds ? 'ok  ' : 'FAIL'} ${said}`);
+
+const browser = await chromium.launch({
+  args: [
+    '--no-sandbox',
+    '--disable-dev-shm-usage',
+    '--use-gl=angle',
+    '--use-angle=swiftshader',
+    '--enable-unsafe-swiftshader',
+    '--js-flags=--max-old-space-size=3072',
+  ],
+});
+const context = await browser.newContext({ viewport: { width: 1280, height: 900 } });
+const page = await context.newPage();
+page.on('pageerror', error => console.log(`pageerror: ${String(error).slice(0, 400)}`));
+let asked_url = null;
+let asked_body = null;
+await context.route(() => true, async route => {
+  const request = route.request();
+  if (request.method() !== 'POST' || !request.url().includes('/v1/'))
+    return route.continue();
+  asked_url = request.url();
+  asked_body = request.postData() ?? '';
+  return route.fulfill({
+    status: 200,
+    headers: { 'Content-Type': 'text/event-stream', 'Access-Control-Allow-Origin': '*' },
+    body: answer,
+  });
+});
+
+await page.goto(url, { waitUntil: 'load' });
+await page.waitForFunction(() => window.__pchat_started === true, null, { timeout: 180000 });
+await page.waitForTimeout(4000);
+// Said into the composer the way a reader says something: the window is one
+// canvas, so where the field is is put to the bottom of it by pointer.
+await page.mouse.click(640, 855);
+await page.keyboard.type('Say something, anything.');
+await page.keyboard.press('Enter');
+await page.waitForTimeout(12000);
+
+console.log(`asked: ${asked_url ?? 'nothing was asked'}`);
+if (asked_body === null) {
+  console.log('FAIL no request left the page at all');
+  await browser.close();
+  process.exit(1);
+}
+console.log(`body: ${asked_body.replace(/\s+/g, ' ').slice(0, 1600)}`);
+let body = null;
+try {
+  body = JSON.parse(asked_body);
+} catch (error) {
+  console.log(`FAIL the body is not JSON: ${String(error).slice(0, 200)}`);
+  await browser.close();
+  process.exit(1);
+}
+
+// What the settings rows say, checked against what went out: the conversation
+// opens on haiku, so this is an anthropic body -- thinking beside a budget,
+// sampling taken off beside it, and the numbers the generation rows move.
+that(body.model === 'haiku-4', `asked of haiku (said ${body.model})`);
+that(!!body.thinking, 'thinking is asked for');
+if (body.thinking) {
+  that(body.thinking.type === 'enabled', `thinking is enabled (said ${body.thinking.type})`);
+  that((body.thinking.budget_tokens ?? 0) >= 1024,
+       `thinking carries a budget of at least 1024 (said ${body.thinking.budget_tokens})`);
+  that(body.temperature === undefined,
+       `temperature is not said beside a thinking (said ${body.temperature})`);
+  that((body.max_tokens ?? 0) > (body.thinking.budget_tokens ?? 0),
+       `max_tokens holds the budget and the answer (said ${body.max_tokens})`);
+}
+that(body.top_p === 1.0, `top_p is the 1.0 a thinking still allows (said ${body.top_p})`);
+that(Array.isArray(body.tools) && body.tools.length === 3,
+     `the three tools are offered (said ${JSON.stringify((body.tools ?? []).map(one => one.name))})`);
+that(typeof body.system === 'string' && body.system.length > 0, 'what it is told goes with it');
+that(Array.isArray(body.messages) && body.messages.length > 0,
+     `the conversation goes with it (${(body.messages ?? []).length} messages)`);
+
+for (const line of checks) console.log(line);
+const failed = checks.filter(line => line.startsWith('FAIL')).length;
+console.log(failed === 0 ? `\n${checks.length} checks held.` : `\n${failed} of ${checks.length} checks did not hold.`);
+await browser.close();
+process.exit(failed === 0 ? 0 : 1);
